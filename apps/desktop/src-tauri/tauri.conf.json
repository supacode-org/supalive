{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SupaLive",
  "identifier": "app.supalive.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "SupaLive",
        "width": 1200,
        "height": 780,
        "minWidth": 900,
        "minHeight": 600,
        "transparent": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; media-src 'self' blob: asset: http://asset.localhost; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": ["$DOWNLOAD/SupaLive/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Video",
    "shortDescription": "抖音直播錄製助手",
    "icon": ["../../../.private/supalive.icon", "icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "languages": ["TradChinese", "English"]
      }
    }
  }
}

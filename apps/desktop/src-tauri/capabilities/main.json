{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "主介面。只配給 main 這個 WebView，不用視窗標籤配對，避免同一視窗裡的抖音側欄也拿到這些權限。",
  "webviews": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "dialog:allow-open",
    "allow-get-state",
    "allow-save-settings",
    "allow-set-locale",
    "allow-add-room",
    "allow-update-room",
    "allow-remove-room",
    "allow-start-recording",
    "allow-stop-recording",
    "allow-merge-recording",
    "allow-remove-recording",
    "allow-save-cover",
    "allow-reveal",
    "allow-watch",
    "allow-unwatch",
    "allow-douyin-open",
    "allow-douyin-close",
    "allow-douyin-hide",
    "allow-douyin-bounds",
    "allow-douyin-back",
    "allow-douyin-reload",
    "allow-douyin-streams"
  ]
}
